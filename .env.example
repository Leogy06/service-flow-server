# Copy to .env.development or .env.production. Use Bash-compatible KEY='value'.
# Existing process environment variables take precedence over these files.
NODE_ENV='development'
PORT=4000
# Legacy diagnostic setting; Express now uses trust proxy=true for visitor logging.
TRUST_PROXY_HOPS=0
# Log one sanitized proxy diagnostic per runtime when diagnosing deployment routing.
TRUST_PROXY_DIAGNOSTICS=false
# Optional counter namespace override; use distinct names for separate previews.
# Otherwise VERCEL_ENV (injected by Vercel), then NODE_ENV is used.
# APP_ENV='preview-branch-name'

# Local Prisma CLI (or legacy local runtime): mysql:// with username/password/host/database.
# Existing local MySQL: mysql://USER:YOUR_LOCAL_PASSWORD@127.0.0.1:3306/service_flow_dev?connection_limit=5
# Production (TLS-capable MySQL): mysql://USER:URL_ENCODED_PASSWORD@REMOTE_HOST:3306/DATABASE?connection_limit=5&sslaccept=strict
# URL-encode special characters in credentials (e.g. @ -> %40, # -> %23, & -> %26).
# Production requires verified TLS. If required, add &sslcert=../certs/server-ca.pem
# Certificate paths are relative to backend/prisma for both API and Prisma CLI.
DATABASE_URL=''
# Aiven runtime: set ALL six together. DATABASE_URL is then local CLI-only.
# DB_HOST='your-aiven-host'
# DB_PORT=28669
# DB_USER='your-user'
# DB_PASSWORD='your-password'
# DB_NAME='your-database'
# DB_CA='full multiline PEM contents, not a filename'
# CRON_SECRET='generate-at-least-16-random-characters'
# INTERNAL_API_SECRET='same-server-only-secret-on-backend-and-frontend'
# See docs/ACCESS_LOGGING.md for TLS, db push and Vercel setup.

# Dev: redis://127.0.0.1:6379
# Production Upstash TCP URL (not HTTPS REST): rediss://default:URL_ENCODED_PASSWORD@ENDPOINT:6379
REDIS_URL='redis://127.0.0.1:6379'
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RETRIES_PER_REQUEST=1
# Local Compose-only published port; does not change REDIS_URL automatically.
# REDIS_PORT=6379
# Exact frontend origin, no trailing slash. Production requires HTTPS.
CORS_ORIGIN='http://localhost:3000'
JWT_ACCESS_SECRET=''
JWT_REFRESH_SECRET=''
ACCESS_TOKEN_EXPIRY=900
REFRESH_TOKEN_DAYS=7
SALT_ROUNDS=10
RESEND_API_KEY=''
EMAIL_FROM=''

# Optional: defaults to debug in development and info in production.
# LOG_LEVEL='info'
LOG_MAX_FILES=14
# Vercel writes structured logs to stdout; VPS also retains rolling files.
# All rate-limit windows use milliseconds. Sensitive budgets remain independent.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=60
STRICT_RATE_LIMIT_WINDOW_MS=3600000
STRICT_RATE_LIMIT_MAX=5
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=30
PUBLIC_WRITE_RATE_LIMIT_WINDOW_MS=3600000
PUBLIC_WRITE_RATE_LIMIT_MAX=30
DELETE_RATE_LIMIT_WINDOW_MS=900000
DELETE_RATE_LIMIT_MAX=5
REFUND_RATE_LIMIT_WINDOW_MS=3600000
REFUND_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_WINDOW_MS=600000
SIGNUP_RATE_LIMIT_MAX=5
FEEDBACK_RATE_LIMIT_WINDOW_MS=600000
FEEDBACK_RATE_LIMIT_MAX=20
FEEDBACK_INVITATION_DAYS=30
BRANDING_UPLOAD_DIR='storage/branding'
BRANDING_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
BRANDING_UPLOAD_RATE_LIMIT_MAX=10
BRANDING_ASSET_RATE_LIMIT_WINDOW_MS=60000
BRANDING_ASSET_RATE_LIMIT_MAX=60
PUBLIC_PAGE_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_PAGE_RATE_LIMIT_MAX=60

# Optional operator-only CLI inputs (never provisioned automatically):
# SYSTEM_ADMIN_EMAIL=''
# SYSTEM_ADMIN_PASSWORD=''
# SYSTEM_ADMIN_REASON=''
# Optional: new local sample accounts only; required for npm run seed:dev -- --apply.
# DEV_SEED_PASSWORD=''
# Optional isolated integration-test database, never your application database:
# PLATFORM_TEST_DATABASE_NAME='service_flow_platform_test_unique_suffix'
