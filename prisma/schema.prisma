generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "mysql"
}

model auditlog {
  id             String         @id
  actorId        String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  organizationId String?
  requestId      String?
  actorType      String         @default("USER")
  scope          auditlog_scope @default(TENANT)
  user           user?          @relation(fields: [actorId], references: [id], map: "AuditLog_actorId_fkey")
  organization   organization?  @relation(fields: [organizationId], references: [id], map: "AuditLog_organizationId_fkey")

  @@index([action], map: "AuditLog_action_idx")
  @@index([actorId], map: "AuditLog_actorId_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([entity, entityId], map: "AuditLog_entity_entityId_idx")
  @@index([organizationId], map: "AuditLog_organizationId_fkey")
  @@index([scope, createdAt, id], map: "AuditLog_scope_createdAt_id_idx")
  @@index([scope, organizationId, createdAt], map: "AuditLog_scope_organizationId_createdAt_idx")
}

model customer {
  id             String           @id
  email          String           @unique(map: "Customer_email_key")
  phoneNumber    String           @unique(map: "Customer_phoneNumber_key")
  address        String?
  createdAt      DateTime         @default(now())
  notes          String?
  updatedAt      DateTime
  organizationId String
  deletedAt      DateTime?
  name           String           @unique(map: "Customer_name_key")
  organization   organization     @relation(fields: [organizationId], references: [id], map: "Customer_organizationId_fkey")
  invoice        invoice[]
  job            job[]
  servicerequest servicerequest[]

  @@index([email], map: "Customer_email_idx")
  @@index([organizationId], map: "Customer_organizationId_fkey")
  @@index([phoneNumber], map: "Customer_phoneNumber_idx")
}

model customerfeedback {
  id                    String                  @id
  organizationId        String
  invitationId          String                  @unique(map: "CustomerFeedback_invitationId_key")
  rating                Int
  comment               String                  @db.VarChar(2000)
  displayName           String?                 @db.VarChar(100)
  consentGrantedAt      DateTime?
  consentVersion        String?                 @db.VarChar(32)
  consentWithdrawnAt    DateTime?
  testimonialApprovedAt DateTime?
  status                customerfeedback_status @default(NEW)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  feedbackinvitation    feedbackinvitation      @relation(fields: [invitationId, organizationId], references: [id, organizationId], map: "CustomerFeedback_invitationId_organizationId_fkey")
  organization          organization            @relation(fields: [organizationId], references: [id], map: "CustomerFeedback_organizationId_fkey")

  @@unique([invitationId, organizationId], map: "CustomerFeedback_invitationId_organizationId_key")
  @@index([organizationId, status, createdAt, id], map: "CustomerFeedback_organizationId_status_createdAt_id_idx")
}

model feedbackinvitation {
  id               String            @id
  organizationId   String
  serviceRequestId String            @unique(map: "FeedbackInvitation_serviceRequestId_key")
  tokenHash        String            @unique(map: "FeedbackInvitation_tokenHash_key") @db.VarChar(64)
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  customerfeedback customerfeedback?
  organization     organization      @relation(fields: [organizationId], references: [id], map: "FeedbackInvitation_organizationId_fkey")
  servicerequest   servicerequest    @relation(fields: [serviceRequestId, organizationId], references: [id, organizationId], map: "FeedbackInvitation_serviceRequestId_organizationId_fkey")

  @@unique([id, organizationId], map: "FeedbackInvitation_id_organizationId_key")
  @@unique([serviceRequestId, organizationId], map: "FeedbackInvitation_serviceRequestId_organizationId_key")
  @@index([organizationId, createdAt], map: "FeedbackInvitation_organizationId_createdAt_idx")
}

model invoice {
  id             String         @id
  invoiceNumber  String         @unique(map: "Invoice_invoiceNumber_key")
  customerId     String
  jobId          String?        @unique(map: "Invoice_jobId_key")
  status         invoice_status @default(UNPAID)
  subtotal       Decimal        @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  amountPaid     Decimal        @default(0.00) @db.Decimal(10, 2)
  issuedAt       DateTime       @default(now())
  dueAt          DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  organizationId String
  customer       customer       @relation(fields: [customerId], references: [id], map: "Invoice_customerId_fkey")
  job            job?           @relation(fields: [jobId], references: [id], map: "Invoice_jobId_fkey")
  organization   organization   @relation(fields: [organizationId], references: [id], map: "Invoice_organizationId_fkey")
  invoiceitem    invoiceitem[]
  payment        payment[]

  @@index([customerId], map: "Invoice_customerId_idx")
  @@index([issuedAt], map: "Invoice_issuedAt_idx")
  @@index([organizationId], map: "Invoice_organizationId_fkey")
  @@index([status], map: "Invoice_status_idx")
}

model invoiceitem {
  id          String   @id
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  invoice     invoice  @relation(fields: [invoiceId], references: [id], map: "InvoiceItem_invoiceId_fkey")

  @@index([invoiceId], map: "InvoiceItem_invoiceId_idx")
}

model job {
  id               String             @id
  serviceRequestId String?
  assignedStaffId  String?
  startedAt        DateTime?
  completedAt      DateTime?
  status           job_status         @default(ASSIGNED)
  createdAt        DateTime           @default(now())
  customerId       String
  description      String?
  internalNotes    String?
  location         String?
  referenceNumber  String             @unique(map: "Job_referenceNumber_key")
  scheduledEnd     DateTime?
  scheduledStart   DateTime?
  serviceTypeId    String
  updatedAt        DateTime
  organizationId   String
  invoice          invoice?
  user             user?              @relation(fields: [assignedStaffId], references: [id], map: "Job_assignedStaffId_fkey")
  customer         customer           @relation(fields: [customerId], references: [id], map: "Job_customerId_fkey")
  organization     organization       @relation(fields: [organizationId], references: [id], map: "Job_organizationId_fkey")
  servicerequest   servicerequest?    @relation(fields: [serviceRequestId], references: [id], map: "Job_serviceRequestId_fkey")
  servicetype      servicetype        @relation(fields: [serviceTypeId], references: [id], map: "Job_serviceTypeId_fkey")
  jobstatushistory jobstatushistory[]

  @@index([assignedStaffId], map: "Job_assignedStaffId_idx")
  @@index([customerId], map: "Job_customerId_idx")
  @@index([organizationId], map: "Job_organizationId_fkey")
  @@index([serviceRequestId], map: "Job_serviceRequestId_idx")
  @@index([serviceTypeId], map: "Job_serviceTypeId_idx")
  @@index([status], map: "Job_status_idx")
}

model jobstatushistory {
  id          String                       @id
  jobId       String
  fromStatus  jobstatushistory_fromStatus?
  toStatus    jobstatushistory_toStatus
  note        String?
  changedById String?
  createdAt   DateTime                     @default(now())
  user        user?                        @relation(fields: [changedById], references: [id], map: "JobStatusHistory_changedById_fkey")
  job         job                          @relation(fields: [jobId], references: [id], map: "JobStatusHistory_jobId_fkey")

  @@index([changedById], map: "JobStatusHistory_changedById_idx")
  @@index([jobId], map: "JobStatusHistory_jobId_idx")
  @@index([toStatus], map: "JobStatusHistory_toStatus_idx")
}

model organization {
  id                         String                       @id
  name                       String
  slug                       String                       @unique(map: "Organization_slug_key")
  status                     organization_status          @default(ACTIVE)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  billingEnabled             Boolean                      @default(false)
  statusChangedAt            DateTime?
  statusChangedBy            String?
  statusReason               String?                      @db.VarChar(1000)
  auditlog                   auditlog[]
  customer                   customer[]
  customerfeedback           customerfeedback[]
  feedbackinvitation         feedbackinvitation[]
  invoice                    invoice[]
  job                        job[]
  organizationpage           organizationpage?
  organizationsettings       organizationsettings?
  permission                 permission[]
  platformalert              platformalert[]
  productfeedback            productfeedback[]
  refreshtoken               refreshtoken[]
  role                       role[]
  servicerequest             servicerequest[]
  servicetype                servicetype[]
  signuprequest              signuprequest?
  subscription               subscription?
  subscriptionpayment        subscriptionpayment[]
  subscriptionupgraderequest subscriptionupgraderequest[]
  user                       user[]

  @@index([status, createdAt], map: "Organization_status_createdAt_idx")
}

model organizationpage {
  organizationId String       @id
  draft          Json
  published      Json?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "OrganizationPage_organizationId_fkey")
}

model organizationsettings {
  organizationId String       @id
  primaryColor   String       @default("#0d887d") @db.VarChar(7)
  displayName    String?      @db.VarChar(100)
  logoUrl        String?
  faviconUrl     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "OrganizationSettings_organizationId_fkey")

  @@index([faviconUrl], map: "OrganizationSettings_faviconUrl_idx")
  @@index([logoUrl], map: "OrganizationSettings_logoUrl_idx")
}

model payment {
  id              String         @id
  invoiceId       String
  amount          Decimal        @db.Decimal(10, 2)
  method          payment_method
  referenceNumber String?
  notes           String?
  receivedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  invoice         invoice        @relation(fields: [invoiceId], references: [id], map: "Payment_invoiceId_fkey")

  @@index([invoiceId], map: "Payment_invoiceId_idx")
  @@index([receivedAt], map: "Payment_receivedAt_idx")
}

model permission {
  id             String           @id
  name           String           @unique(map: "Permission_name_key")
  description    String?
  organizationId String?
  organization   organization?    @relation(fields: [organizationId], references: [id], map: "Permission_organizationId_fkey")
  rolepermission rolepermission[]
  userpermission userpermission[]

  @@index([organizationId], map: "Permission_organizationId_fkey")
}

model plan {
  id                         String                       @id
  name                       String                       @unique(map: "Plan_name_key") @db.VarChar(100)
  description                String?                      @db.VarChar(1000)
  annualPrice                Decimal                      @db.Decimal(12, 2)
  currency                   String                       @default("PHP") @db.Char(3)
  maxActiveUsers             Int
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  billingInterval            plan_billingInterval         @default(YEARLY)
  platformsettings           platformsettings[]
  subscription               subscription[]
  subscriptionupgraderequest subscriptionupgraderequest[]
}

model platformalert {
  id               String        @id
  deduplicationKey String        @unique(map: "PlatformAlert_deduplicationKey_key")
  organizationId   String?
  kind             String        @db.VarChar(80)
  severity         String        @db.VarChar(20)
  message          String        @db.VarChar(1000)
  targetType       String        @db.VarChar(80)
  targetId         String
  readAt           DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  organization     organization? @relation(fields: [organizationId], references: [id], map: "PlatformAlert_organizationId_fkey")

  @@index([organizationId], map: "PlatformAlert_organizationId_idx")
  @@index([resolvedAt, createdAt], map: "PlatformAlert_resolvedAt_createdAt_idx")
}

model platformsettings {
  id                  String   @id @default("singleton")
  reminderIntervals   Json
  gracePeriodDays     Int      @default(0)
  paymentInstructions String   @db.Text
  supportEmail        String?  @db.VarChar(254)
  supportPhone        String?  @db.VarChar(50)
  maintenanceMessage  String   @db.Text
  defaultPlanId       String?
  updatedAt           DateTime
  plan                plan?    @relation(fields: [defaultPlanId], references: [id], map: "PlatformSettings_defaultPlanId_fkey")

  @@index([defaultPlanId], map: "PlatformSettings_defaultPlanId_fkey")
}

model productfeedback {
  id                    String                 @id
  organizationId        String
  authorId              String
  submissionKey         String                 @db.VarChar(36)
  rating                Int
  comment               String                 @db.VarChar(2000)
  displayName           String?                @db.VarChar(100)
  consentGrantedAt      DateTime?
  consentVersion        String?                @db.VarChar(32)
  consentWithdrawnAt    DateTime?
  testimonialApprovedAt DateTime?
  status                productfeedback_status @default(NEW)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  user                  user                   @relation(fields: [authorId], references: [id], map: "ProductFeedback_authorId_fkey")
  organization          organization           @relation(fields: [organizationId], references: [id], map: "ProductFeedback_organizationId_fkey")

  @@unique([authorId, submissionKey], map: "ProductFeedback_authorId_submissionKey_key")
  @@index([organizationId, authorId, createdAt], map: "ProductFeedback_organizationId_authorId_createdAt_idx")
  @@index([status, createdAt, id], map: "ProductFeedback_status_createdAt_id_idx")
}

model refreshtoken {
  id             String        @id
  token          String        @unique(map: "RefreshToken_token_key")
  userId         String
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id], map: "RefreshToken_organizationId_fkey")
  user           user          @relation(fields: [userId], references: [id], map: "RefreshToken_userId_fkey")

  @@index([expiresAt], map: "RefreshToken_expiresAt_idx")
  @@index([organizationId], map: "RefreshToken_organizationId_fkey")
  @@index([userId], map: "RefreshToken_userId_idx")
}

model role {
  id             String           @id
  name           String
  organizationId String?
  deletedAt      DateTime?
  organization   organization?    @relation(fields: [organizationId], references: [id], map: "Role_organizationId_fkey")
  rolepermission rolepermission[]
  user           user[]

  @@unique([name, organizationId], map: "Role_name_organizationId_key")
  @@index([organizationId, deletedAt, name], map: "Role_organizationId_deletedAt_name_idx")
}

model rolepermission {
  roleId       String
  permissionId String
  isActive     Boolean    @default(true)
  id           String     @id
  permission   permission @relation(fields: [permissionId], references: [id], map: "RolePermission_permissionId_fkey")
  role         role       @relation(fields: [roleId], references: [id], map: "RolePermission_roleId_fkey")

  @@unique([roleId, permissionId], map: "RolePermission_roleId_permissionId_key")
  @@index([permissionId], map: "RolePermission_permissionId_idx")
  @@index([roleId], map: "RolePermission_roleId_idx")
}

model servicerequest {
  id                 String                  @id
  customerId         String
  serviceTypeId      String
  status             servicerequest_status   @default(PENDING)
  createdAt          DateTime                @default(now())
  description        String?                 @db.Text
  location           String?
  preferredDate      DateTime?
  referenceNumber    String                  @unique(map: "ServiceRequest_referenceNumber_key")
  trackingToken      String?                 @unique(map: "ServiceRequest_trackingToken_key")
  updatedAt          DateTime
  organizationId     String
  title              String                  @default("") @db.VarChar(200)
  priority           servicerequest_priority @default(NORMAL)
  feedbackinvitation feedbackinvitation?
  job                job[]
  customer           customer                @relation(fields: [customerId], references: [id], map: "ServiceRequest_customerId_fkey")
  organization       organization            @relation(fields: [organizationId], references: [id], map: "ServiceRequest_organizationId_fkey")
  servicetype        servicetype             @relation(fields: [serviceTypeId], references: [id], map: "ServiceRequest_serviceTypeId_fkey")

  @@unique([id, organizationId], map: "ServiceRequest_id_organizationId_key")
  @@index([customerId], map: "ServiceRequest_customerId_idx")
  @@index([organizationId, createdAt, id], map: "ServiceRequest_organizationId_createdAt_id_idx")
  @@index([organizationId, serviceTypeId, createdAt], map: "ServiceRequest_organizationId_serviceTypeId_createdAt_idx")
  @@index([organizationId, status, createdAt], map: "ServiceRequest_organizationId_status_createdAt_idx")
  @@index([referenceNumber], map: "ServiceRequest_referenceNumber_idx")
  @@index([serviceTypeId], map: "ServiceRequest_serviceTypeId_idx")
  @@index([status], map: "ServiceRequest_status_idx")
}

model servicetype {
  id             String           @id
  name           String
  description    String?          @db.Text
  basePrice      Decimal          @db.Decimal(10, 2)
  createdAt      DateTime         @default(now())
  isActive       Boolean          @default(true)
  updatedAt      DateTime
  organizationId String
  job            job[]
  servicerequest servicerequest[]
  organization   organization     @relation(fields: [organizationId], references: [id], map: "ServiceType_organizationId_fkey")

  @@unique([organizationId, name], map: "ServiceType_organizationId_name_key")
  @@index([isActive], map: "ServiceType_isActive_idx")
  @@index([organizationId], map: "ServiceType_organizationId_idx")
}

model signuprequest {
  id               String               @id
  email            String               @unique(map: "SignupRequest_email_key")
  passwordHash     String?
  firstName        String               @db.VarChar(100)
  lastName         String               @db.VarChar(100)
  middleName       String?              @db.VarChar(100)
  suffix           String?              @db.VarChar(20)
  phone            String?              @db.VarChar(16)
  organizationName String               @db.VarChar(100)
  slug             String               @db.VarChar(50)
  status           signuprequest_status @default(PENDING)
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewReason     String?              @db.VarChar(1000)
  organizationId   String?              @unique(map: "SignupRequest_organizationId_key")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  termsAcceptedAt  DateTime?
  termsVersion     String?              @db.VarChar(32)
  privacyVersion   String?              @db.VarChar(32)
  organization     organization?        @relation(fields: [organizationId], references: [id], map: "SignupRequest_organizationId_fkey")

  @@index([status, createdAt, id], map: "SignupRequest_status_createdAt_id_idx")
}

model subscription {
  id                         String                       @id
  organizationId             String                       @unique(map: "Subscription_organizationId_key")
  planId                     String
  status                     subscription_status          @default(PENDING)
  startsAt                   DateTime?
  expiresAt                  DateTime?
  renewalType                String                       @default("MANUAL") @db.VarChar(20)
  annualPrice                Decimal                      @db.Decimal(12, 2)
  currency                   String                       @db.Char(3)
  version                    Int                          @default(0)
  currentPeriodPaymentId     String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  billingInterval            subscription_billingInterval @default(YEARLY)
  trialStartedAt             DateTime?
  trialExpiresAt             DateTime?
  organization               organization                 @relation(fields: [organizationId], references: [id], map: "Subscription_organizationId_fkey")
  plan                       plan                         @relation(fields: [planId], references: [id], map: "Subscription_planId_fkey")
  subscriptionhistory        subscriptionhistory[]
  subscriptionpayment        subscriptionpayment[]
  subscriptionupgraderequest subscriptionupgraderequest[]

  @@index([planId], map: "Subscription_planId_idx")
  @@index([status, expiresAt], map: "Subscription_status_expiresAt_idx")
}

model subscriptionhistory {
  id                  String               @id
  subscriptionId      String
  kind                String               @db.VarChar(80)
  before              Json?
  after               Json?
  paymentId           String?              @unique(map: "SubscriptionHistory_paymentId_key")
  actorId             String?
  reason              String               @db.VarChar(1000)
  createdAt           DateTime             @default(now())
  subscriptionpayment subscriptionpayment? @relation(fields: [paymentId], references: [id], map: "SubscriptionHistory_paymentId_fkey")
  subscription        subscription         @relation(fields: [subscriptionId], references: [id], map: "SubscriptionHistory_subscriptionId_fkey")

  @@index([subscriptionId, createdAt], map: "SubscriptionHistory_subscriptionId_createdAt_idx")
}

model subscriptionpayment {
  id                        String                              @id
  organizationId            String
  subscriptionId            String
  amount                    Decimal                             @db.Decimal(12, 2)
  currency                  String                              @db.Char(3)
  paymentMethod             subscriptionpayment_paymentMethod
  referenceNumber           String                              @unique(map: "SubscriptionPayment_referenceNumber_key") @db.VarChar(150)
  idempotencyKey            String                              @unique(map: "SubscriptionPayment_idempotencyKey_key") @db.VarChar(100)
  status                    subscriptionpayment_status          @default(PENDING)
  paidAt                    DateTime
  verifiedAt                DateTime?
  verifiedBy                String?
  verificationReason        String?                             @db.VarChar(1000)
  evidence                  String?                             @db.VarChar(1000)
  periodStartsAt            DateTime?
  periodExpiresAt           DateTime?
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime
  billingInterval           subscriptionpayment_billingInterval @default(YEARLY)
  subscriptionhistory       subscriptionhistory?
  organization              organization                        @relation(fields: [organizationId], references: [id], map: "SubscriptionPayment_organizationId_fkey")
  subscription              subscription                        @relation(fields: [subscriptionId], references: [id], map: "SubscriptionPayment_subscriptionId_fkey")
  subscriptionrefund        subscriptionrefund?
  subscriptionrefundrequest subscriptionrefundrequest[]

  @@index([organizationId, createdAt], map: "SubscriptionPayment_organizationId_createdAt_idx")
  @@index([status, createdAt], map: "SubscriptionPayment_status_createdAt_idx")
  @@index([subscriptionId], map: "SubscriptionPayment_subscriptionId_idx")
  @@index([verifiedAt], map: "SubscriptionPayment_verifiedAt_idx")
}

model subscriptionrefund {
  id                        String                     @id
  paymentId                 String                     @unique(map: "SubscriptionRefund_paymentId_key")
  amount                    Decimal                    @db.Decimal(12, 2)
  currency                  String                     @db.Char(3)
  idempotencyKey            String                     @unique(map: "SubscriptionRefund_idempotencyKey_key") @db.VarChar(100)
  reason                    String                     @db.VarChar(1000)
  evidence                  String                     @db.VarChar(1000)
  actorId                   String
  createdAt                 DateTime                   @default(now())
  requestId                 String?                    @unique(map: "SubscriptionRefund_requestId_key")
  subscriptionpayment       subscriptionpayment        @relation(fields: [paymentId], references: [id], map: "SubscriptionRefund_paymentId_fkey")
  subscriptionrefundrequest subscriptionrefundrequest? @relation(fields: [requestId], references: [id], map: "SubscriptionRefund_requestId_fkey")

  @@index([createdAt], map: "SubscriptionRefund_createdAt_idx")
}

model subscriptionrefundrequest {
  id                  String                           @id
  paymentId           String
  activePaymentId     String?                          @unique(map: "SubscriptionRefundRequest_activePaymentId_key")
  idempotencyKey      String                           @unique(map: "SubscriptionRefundRequest_idempotencyKey_key") @db.VarChar(100)
  status              subscriptionrefundrequest_status @default(REQUESTED)
  reason              String                           @db.VarChar(1000)
  evidence            String                           @db.VarChar(1000)
  actorId             String
  reviewReason        String?                          @db.VarChar(1000)
  reviewedBy          String?
  reviewedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime
  subscriptionrefund  subscriptionrefund?
  subscriptionpayment subscriptionpayment              @relation(fields: [paymentId], references: [id], map: "SubscriptionRefundRequest_paymentId_fkey")

  @@index([paymentId, createdAt], map: "SubscriptionRefundRequest_paymentId_createdAt_idx")
  @@index([status, createdAt], map: "SubscriptionRefundRequest_status_createdAt_idx")
}

model subscriptionupgraderequest {
  id                   String                                     @id
  organizationId       String
  subscriptionId       String
  activeSubscriptionId String?                                    @unique(map: "SubscriptionUpgradeRequest_activeSubscriptionId_key")
  planId               String
  sourcePlanId         String
  subscriptionVersion  Int
  planName             String                                     @db.VarChar(100)
  price                Decimal                                    @db.Decimal(12, 2)
  currency             String                                     @db.Char(3)
  billingInterval      subscriptionupgraderequest_billingInterval
  maxActiveUsers       Int
  status               subscriptionupgraderequest_status          @default(REQUESTED)
  reason               String                                     @db.VarChar(1000)
  actorId              String
  idempotencyKey       String                                     @db.VarChar(100)
  reviewReason         String?                                    @db.VarChar(1000)
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime                                   @default(now())
  updatedAt            DateTime
  organization         organization                               @relation(fields: [organizationId], references: [id], map: "SubscriptionUpgradeRequest_organizationId_fkey")
  plan                 plan                                       @relation(fields: [planId], references: [id], map: "SubscriptionUpgradeRequest_planId_fkey")
  subscription         subscription                               @relation(fields: [subscriptionId], references: [id], map: "SubscriptionUpgradeRequest_subscriptionId_fkey")

  @@unique([organizationId, idempotencyKey], map: "SubscriptionUpgradeRequest_organizationId_idempotencyKey_key")
  @@index([planId], map: "SubscriptionUpgradeRequest_planId_fkey")
  @@index([status, createdAt], map: "SubscriptionUpgradeRequest_status_createdAt_idx")
  @@index([subscriptionId, createdAt], map: "SubscriptionUpgradeRequest_subscriptionId_createdAt_idx")
}

model user {
  id                String              @id
  email             String              @unique(map: "User_email_key")
  password          String?
  firstName         String
  lastName          String
  middleName        String?
  suffix            String?
  createdAt         DateTime            @default(now())
  phone             String?             @unique(map: "User_phone_key")
  status            user_status         @default(PENDING)
  updatedAt         DateTime
  deletedAt         DateTime?
  organizationId    String?
  roleId            String
  inviteToken       String?             @unique(map: "User_inviteToken_key")
  inviteTokenExpiry DateTime?
  platformRole      user_platformRole   @default(NONE)
  securityChangedAt DateTime?
  securityChangedBy String?
  securityReason    String?             @db.VarChar(1000)
  securityStatus    user_securityStatus @default(ACTIVE)
  sessionVersion    Int                 @default(0)
  auditlog          auditlog[]
  job               job[]
  jobstatushistory  jobstatushistory[]
  productfeedback   productfeedback[]
  refreshtoken      refreshtoken[]
  organization      organization?       @relation(fields: [organizationId], references: [id], map: "User_organizationId_fkey")
  role              role                @relation(fields: [roleId], references: [id], map: "User_roleId_fkey")
  userpermission    userpermission[]

  @@index([organizationId], map: "User_organizationId_idx")
  @@index([organizationId, status, deletedAt], map: "User_organizationId_status_deletedAt_idx")
  @@index([platformRole, securityStatus], map: "User_platformRole_securityStatus_idx")
  @@index([roleId], map: "User_roleId_idx")
  @@index([status], map: "User_status_idx")
}

model userpermission {
  userId       String
  permissionId String
  id           String     @id
  isActive     Boolean    @default(true)
  permission   permission @relation(fields: [permissionId], references: [id], map: "UserPermission_permissionId_fkey")
  user         user       @relation(fields: [userId], references: [id], map: "UserPermission_userId_fkey")

  @@unique([userId, permissionId], map: "UserPermission_userId_permissionId_key")
  @@index([permissionId], map: "UserPermission_permissionId_fkey")
}

