// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  NONE
  SYSTEM_ADMIN
}

enum AccountSecurityStatus {
  ACTIVE
  BLOCKED
}

enum AuditScope {
  TENANT
  PLATFORM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum SubscriptionPaymentStatus {
  PENDING
  UNDER_REVIEW
  PAID
  REJECTED
  REFUNDED
}

enum SubscriptionRefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum SubscriptionUpgradeRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Public applications have no tenant or permissions until a platform operator approves.
model SignupRequest {
  id String @id @default(cuid())
  email String @unique @db.VarChar(191)
  passwordHash String? @db.VarChar(191)
  firstName String @db.VarChar(100)
  lastName String @db.VarChar(100)
  middleName String? @db.VarChar(100)
  suffix String? @db.VarChar(20)
  phone String? @db.VarChar(16)
  organizationName String @db.VarChar(100)
  slug String @db.VarChar(50)
  // Nullable only for applications submitted before versioned acceptance existed.
  termsAcceptedAt DateTime?
  termsVersion String? @db.VarChar(32)
  privacyVersion String? @db.VarChar(32)
  status SignupRequestStatus @default(PENDING)
  reviewedBy String? @db.VarChar(191)
  reviewedAt DateTime?
  reviewReason String? @db.VarChar(1000)
  organizationId String? @unique
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt, id])
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  CARD
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  STATUS_CHANGE
  PAYMENT
}

//ORGANIZATION
model Organization {
  id     String             @id @default(cuid())
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)
  billingEnabled Boolean @default(false)
  statusReason String? @db.VarChar(1000)
  statusChangedAt DateTime?
  statusChangedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  serviceTypes    ServiceType[]
  serviceRequests ServiceRequest[]
  jobs            Job[]
  invoices        Invoice[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]

  roles       Role[]
  permissions Permission[]
  subscription Subscription?
  subscriptionUpgradeRequests SubscriptionUpgradeRequest[]
  subscriptionPayments SubscriptionPayment[]
  platformAlerts PlatformAlert[]
  signupRequest SignupRequest?
  productFeedback ProductFeedback[]
  feedbackInvitations FeedbackInvitation[]
  customerFeedback CustomerFeedback[]
  settings OrganizationSettings?

  @@index([status, createdAt])
}

model OrganizationSettings {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryColor String @default("#b91c1c") @db.VarChar(7)
  displayName String? @db.VarChar(100)
  logoUrl String? @db.VarChar(191)
  faviconUrl String? @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([logoUrl])
  @@index([faviconUrl])
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  email      String  @unique
  password   String?
  firstName  String
  lastName   String
  middleName String?
  suffix     String?
  phone      String? @unique

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  roleId String
  status UserStatus @default(PENDING)
  platformRole PlatformRole @default(NONE)
  securityStatus AccountSecurityStatus @default(ACTIVE)
  securityReason String? @db.VarChar(1000)
  securityChangedAt DateTime?
  securityChangedBy String?
  sessionVersion Int @default(0)

  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())

  auditLogs          AuditLog[]
  jobs               Job[]
  jobStatusHistories JobStatusHistory[]
  productFeedback ProductFeedback[]
  refreshTokens      RefreshToken[]
  role               Role               @relation(fields: [roleId], references: [id])
  userPermissions    UserPermission[]

  @@index([roleId])
  @@index([status])
  @@index([organizationId])
  @@index([organizationId, status, deletedAt])
  @@index([platformRole, securityStatus])
}

//role

model Role {
  id             String  @id @default(cuid())
  name           String
  organizationId String?
  deletedAt      DateTime?

  organization Organization?    @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([name, organizationId])
  @@index([organizationId, deletedAt, name])
}

//permission
model Permission {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String?
  organizationId String?

  organization Organization?    @relation(fields: [organizationId], references: [id])
  roles        RolePermission[]
  users        UserPermission[]
}

//join table
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  isActive Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

//user permission
model UserPermission {
  id           String @id @default(cuid())
  userId       String
  permissionId String

  isActive Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id String @id @default(cuid())

  name String @unique

  email       String  @unique
  phoneNumber String  @unique

  address String?
  notes   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  serviceRequests ServiceRequest[]
  jobs            Job[]
  invoices        Invoice[]

  @@index([email])
  @@index([phoneNumber])
}

// ─────────────────────────────────────────────
// SERVICE TYPE
// ─────────────────────────────────────────────

model ServiceType {
  id String @id @default(cuid())

  name        String
  description String? @db.Text

  basePrice Decimal @db.Decimal(10, 2) // in php
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRequests ServiceRequest[]
  jobs            Job[]
  organization    Organization     @relation(fields: [organizationId], references: [id])
  organizationId  String

  @@unique([organizationId, name])
  @@index([isActive])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// SERVICE REQUEST
// ─────────────────────────────────────────────

model ServiceRequest {
  id String @id @default(cuid())

  //human-readable unique identifier for the service request
  referenceNumber String @unique
  customerId      String
  serviceTypeId   String

  title    String @default("") @db.VarChar(200)
  priority ServiceRequestPriority @default(NORMAL)

  description String? @db.Text
  location    String?

  preferredDate DateTime?

  status ServiceRequestStatus @default(PENDING)

  //public customer tracking
  trackingToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  jobs           Job[]
  feedbackInvitation FeedbackInvitation?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@index([customerId])
  @@index([serviceTypeId])
  @@index([status])
  @@index([referenceNumber])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, serviceTypeId, createdAt])
  @@unique([id, organizationId])
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

// Feedback about Service Flow is visible only to its author and platform operators.
model ProductFeedback {
  id String @id @default(cuid())
  organizationId String
  authorId String
  submissionKey String @db.VarChar(36)
  rating Int
  comment String @db.VarChar(2000)
  displayName String? @db.VarChar(100)
  consentGrantedAt DateTime?
  consentVersion String? @db.VarChar(32)
  consentWithdrawnAt DateTime?
  testimonialApprovedAt DateTime?
  status FeedbackStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  @@unique([authorId, submissionKey])
  @@index([status, createdAt, id])
  @@index([organizationId, authorId, createdAt])
}

// Tokens are returned once and stored only as SHA-256 hashes.
model FeedbackInvitation {
  id String @id @default(cuid())
  organizationId String
  serviceRequestId String @unique
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId, organizationId], references: [id, organizationId])
  feedback CustomerFeedback?
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@unique([serviceRequestId, organizationId])
}

model CustomerFeedback {
  id String @id @default(cuid())
  organizationId String
  invitationId String @unique
  rating Int
  comment String @db.VarChar(2000)
  displayName String? @db.VarChar(100)
  consentGrantedAt DateTime?
  consentVersion String? @db.VarChar(32)
  consentWithdrawnAt DateTime?
  testimonialApprovedAt DateTime?
  status FeedbackStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  invitation FeedbackInvitation @relation(fields: [invitationId, organizationId], references: [id, organizationId])
  @@unique([invitationId, organizationId])
  @@index([organizationId, status, createdAt, id])
}

// ─────────────────────────────────────────────
// JOB / WORK ORDER
// ─────────────────────────────────────────────

model Job {
  id String @id @default(cuid())

  referenceNumber String @unique

  customerId    String
  serviceTypeId String

  // Service request that generated this job
  serviceRequestId String?

  //assigned staff member for this job  
  assignedStaffId String?

  description String?
  location    String?

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  status JobStatus @default(ASSIGNED)

  startedAt   DateTime?
  completedAt DateTime?

  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  assignedStaff User? @relation(fields: [assignedStaffId], references: [id])

  statusHistory JobStatusHistory[]

  invoice        Invoice?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@index([customerId])
  @@index([serviceTypeId])
  @@index([serviceRequestId])
  @@index([assignedStaffId])
  @@index([status])
}

// ─────────────────────────────────────────────
// JOB STATUS HISTORY
// ─────────────────────────────────────────────

model JobStatusHistory {
  id    String @id @default(cuid())
  jobId String

  fromStatus JobStatus?
  toStatus   JobStatus

  note String?

  changedById String?

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([jobId])
  @@index([changedById])
  @@index([toStatus])
}

// ─────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────

model Invoice {
  id String @id @default(cuid())

  //human-readable unique identifier for the invoice
  invoiceNumber String @unique

  customerId String

  //a job should normally have one invoice
  jobId String? @unique

  status InvoiceStatus @default(UNPAID)

  subtotal   Decimal @db.Decimal(10, 2) //before tax, discounts, vouchers, etc.
  total      Decimal @db.Decimal(10, 2) //after tax, discounts, vouchers, etc.
  amountPaid Decimal @default(0) @db.Decimal(10, 2) //total amount paid so far

  issuedAt DateTime  @default(now())
  dueAt    DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  job      Job?     @relation(fields: [jobId], references: [id])

  items          InvoiceItem[]
  payments       Payment[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String

  @@index([customerId])
  @@index([status])
  @@index([issuedAt])
}

// ─────────────────────────────────────────────
// INVOICE ITEM
// ─────────────────────────────────────────────

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String

  description String

  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  amount    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id String @id @default(cuid())

  invoiceId String // The invoice that this payment is for, could be the same as the job's invoice or a different one if the customer is paying for multiple jobs at once.

  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod

  referenceNumber String?

  notes String?

  receivedAt DateTime @default(now())

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────
model AuditLog {
  id String @id @default(cuid())
  scope AuditScope @default(TENANT)
  actorType String @default("USER")

  actorId String? //	Who did it — a User (staff/admin). Nullable because some actions are automated (system cron job, webhook, no human involved).

  action String

  entity   String //model 
  entityId String //model instance id

  //addtional contextual information 
  //json
  // e.g {
  //   "oldStatus": "UNPAID",
  //   "newStatus": "PAID",
  //   "amount": 155.00
  // }
  //still flexible enough to store any other details about the action, e.g. which fields were changed, what the old and new values were, etc.
  metadata Json? //	Extra details as flexible JSON — e.g. { "oldStatus": "UNPAID", "newStatus": "PAID" } or { "changedFields": ["email", "phone"] }

  ipAddress String? //Where/how it happened — useful for security investigations ("was this really the staff member, or someone else logged in?")
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  actor          User?         @relation(fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([scope, createdAt, id])
  @@index([scope, organizationId, createdAt])
}

// Platform billing is intentionally separate from tenant customer invoices/payments.
model Plan {
  id String @id @default(cuid())
  name String @unique @db.VarChar(100)
  description String? @db.VarChar(1000)
  price Decimal @map("annualPrice") @db.Decimal(12, 2)
  billingInterval BillingInterval @default(YEARLY)
  currency String @default("PHP") @db.Char(3)
  maxActiveUsers Int
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions Subscription[]
  settings PlatformSettings[]
  upgradeRequests SubscriptionUpgradeRequest[]
}

model Subscription {
  id String @id @default(cuid())
  organizationId String @unique
  planId String
  status SubscriptionStatus @default(PENDING)
  startsAt DateTime?
  expiresAt DateTime?
  trialStartedAt DateTime?
  trialExpiresAt DateTime?
  renewalType String @default("MANUAL") @db.VarChar(20)
  price Decimal @map("annualPrice") @db.Decimal(12, 2)
  billingInterval BillingInterval @default(YEARLY)
  currency String @db.Char(3)
  version Int @default(0)
  currentPeriodPaymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]
  history SubscriptionHistory[]
  upgradeRequests SubscriptionUpgradeRequest[]
  @@index([status, expiresAt])
  @@index([planId])
}

model SubscriptionUpgradeRequest {
  id String @id @default(cuid())
  organizationId String
  subscriptionId String
  activeSubscriptionId String? @unique
  planId String
  sourcePlanId String
  subscriptionVersion Int
  planName String @db.VarChar(100)
  price Decimal @db.Decimal(12, 2)
  currency String @db.Char(3)
  billingInterval BillingInterval
  maxActiveUsers Int
  status SubscriptionUpgradeRequestStatus @default(REQUESTED)
  reason String @db.VarChar(1000)
  actorId String
  idempotencyKey String @db.VarChar(100)
  reviewReason String? @db.VarChar(1000)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
  @@unique([organizationId, idempotencyKey])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

model SubscriptionHistory {
  id String @id @default(cuid())
  subscriptionId String
  kind String @db.VarChar(80)
  before Json?
  after Json?
  paymentId String? @unique
  actorId String?
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now())
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payment SubscriptionPayment? @relation(fields: [paymentId], references: [id])
  @@index([subscriptionId, createdAt])
}

model SubscriptionPayment {
  id String @id @default(cuid())
  organizationId String
  subscriptionId String
  amount Decimal @db.Decimal(12, 2)
  currency String @db.Char(3)
  paymentMethod PaymentMethod
  referenceNumber String @unique @db.VarChar(150)
  idempotencyKey String @unique @db.VarChar(100)
  status SubscriptionPaymentStatus @default(PENDING)
  paidAt DateTime
  verifiedAt DateTime?
  verifiedBy String?
  verificationReason String? @db.VarChar(1000)
  evidence String? @db.VarChar(1000)
  billingInterval BillingInterval @default(YEARLY)
  periodStartsAt DateTime?
  periodExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  history SubscriptionHistory[]
  refund SubscriptionRefund?
  refundRequests SubscriptionRefundRequest[]
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@index([verifiedAt])
}

model SubscriptionRefund {
  id String @id @default(cuid())
  paymentId String @unique
  amount Decimal @db.Decimal(12, 2)
  currency String @db.Char(3)
  idempotencyKey String @unique @db.VarChar(100)
  reason String @db.VarChar(1000)
  evidence String @db.VarChar(1000)
  actorId String
  requestId String? @unique
  createdAt DateTime @default(now())
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])
  request SubscriptionRefundRequest? @relation(fields: [requestId], references: [id])
  @@index([createdAt])
}

model SubscriptionRefundRequest {
  id String @id @default(cuid())
  paymentId String
  // Only open requests hold this key; rejected/completed requests retain history.
  activePaymentId String? @unique
  idempotencyKey String @unique @db.VarChar(100)
  status SubscriptionRefundRequestStatus @default(REQUESTED)
  reason String @db.VarChar(1000)
  evidence String @db.VarChar(1000)
  actorId String
  reviewReason String? @db.VarChar(1000)
  reviewedBy String?
  reviewedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])
  refund SubscriptionRefund?
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model PlatformAlert {
  id String @id @default(cuid())
  deduplicationKey String @unique @db.VarChar(191)
  organizationId String?
  kind String @db.VarChar(80)
  severity String @db.VarChar(20)
  message String @db.VarChar(1000)
  targetType String @db.VarChar(80)
  targetId String
  readAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id])
  @@index([resolvedAt, createdAt])
  @@index([organizationId])
}

model PlatformSettings {
  id String @id @default("singleton")
  reminderIntervals Json
  gracePeriodDays Int @default(0)
  paymentInstructions String @db.Text
  supportEmail String? @db.VarChar(254)
  supportPhone String? @db.VarChar(50)
  maintenanceMessage String @db.Text
  defaultPlanId String?
  defaultPlan Plan? @relation(fields: [defaultPlanId], references: [id])
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}
