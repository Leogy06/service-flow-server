{
  "name": "service_flow",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "type": "module",
  "scripts": {
    "test:predeploy": "node scripts/predeploy.mjs",
    "test:predeploy:vps": "node scripts/predeploy.mjs --vps",
    "test:predeploy:runner": "node --test scripts/predeploy-safety.mjs",
    "bootstrap:system-admin": "node dist/modules/system-admin/bootstrap.cli.js --bootstrap-system-admin",
    "bootstrap:system-admin:dev": "tsx src/modules/system-admin/bootstrap.cli.ts --bootstrap-system-admin",
    "alerts:process": "node dist/modules/system-admin/process-alerts.cli.js",
    "alerts:process:dev": "tsx src/modules/system-admin/process-alerts.cli.ts",
    "test:system-admin:mysql": "cross-env RUN_DB_PLATFORM_TESTS=1 LOG_LEVEL=error NODE_ENV=test node --import tsx tests/system-admin/mysql.integration.mjs",
    "test:system-admin:mysql:isolated": "node scripts/run-platform-mysql-tests.mjs --isolated-test-database",
    "test:feedback:mysql:isolated": "node scripts/run-platform-mysql-tests.mjs --isolated-test-database --feedback-only",
    "test:branding:mysql:isolated": "node scripts/run-platform-mysql-tests.mjs --isolated-test-database --branding-only",
    "test:website:mysql:isolated": "node scripts/run-platform-mysql-tests.mjs --isolated-test-database --website-only",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:all": "bash scripts/run.sh dev",
    "prod:all": "bash scripts/run.sh prod",
    "prisma:generate": "node scripts/prisma.mjs --preset=generate",
    "prisma:migrate": "node scripts/prisma.mjs --preset=migrate-dev",
    "prisma:deploy": "node scripts/prisma.mjs --preset=migrate-deploy",
    "seed:admin": "node scripts/prisma.mjs --preset=seed-admin",
    "seed:roles": "node scripts/prisma.mjs --preset=seed-roles",
    "seed:customers": "node scripts/prisma.mjs --preset=seed-customers",
    "seed:service-types": "node scripts/prisma.mjs --preset=seed-service-types",
    "seed:plans": "node scripts/prisma.mjs --preset=seed-plans",
    "seed:catalog": "node scripts/prisma.mjs --preset=seed-catalog",
    "seed:bright-star": "node scripts/prisma.mjs --preset=seed-bright-star",
    "seed:dev": "node scripts/prisma.mjs dev seed development",
    "seed:prod": "node scripts/prisma.mjs prod seed production",
    "test:seed:dev:mysql": "node scripts/prisma.mjs dev seed development-check",
    "test:seed:bright-star:mysql": "cross-env LOG_LEVEL=error node --import tsx tests/prisma/bright-star.mysql.mjs",
    "generate": "prisma generate",
    "dev:setup": "npm run generate",
    "prod:build": "npm run generate && npm run build",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:config:launcher": "node --test --test-isolation=none tests/config/launcher.mjs",
    "test:service-requests:mysql": "cross-env RUN_DB_SERVICE_REQUEST_TESTS=1 LOG_LEVEL=fatal NODE_ENV=test node --import tsx tests/service-request/mysql.integration.mjs",
    "test:service-requests:browser": "cross-env RUN_DB_SERVICE_REQUEST_TESTS=1 RUN_BROWSER_SERVICE_REQUEST_TESTS=1 LOG_LEVEL=fatal NODE_ENV=test node --import tsx tests/service-request/mysql.integration.mjs",
    "test:workflow:mysql": "cross-env RUN_DB_WORKFLOW_TESTS=1 LOG_LEVEL=fatal NODE_ENV=test node --import tsx tests/workflow/mysql.integration.mjs",
    "test:workflow:browser": "cross-env RUN_DB_WORKFLOW_TESTS=1 RUN_BROWSER_WORKFLOW_TESTS=1 LOG_LEVEL=fatal NODE_ENV=test node --import tsx tests/workflow/mysql.integration.mjs",
    "test:access:mysql": "cross-env RUN_DB_ACCESS_TESTS=1 LOG_LEVEL=error NODE_ENV=test node --import tsx tests/access-management/mysql.integration.mjs",
    "test:access:browser": "cross-env RUN_DB_ACCESS_TESTS=1 RUN_BROWSER_ACCESS_TESTS=1 LOG_LEVEL=error NODE_ENV=test node --import tsx tests/access-management/mysql.integration.mjs",
    "prisma:dev": "node scripts/prisma.mjs dev",
    "prisma:prod": "node scripts/prisma.mjs prod",
    "studio:prod": "node scripts/prisma.mjs prod studio",
    "test:config:prisma": "node --test --test-isolation=none tests/config/prisma-cli.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "mariadb": "3.5.4"
  },
  "version": "1.0.0",
  "description": "",
  "main": "jest.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
