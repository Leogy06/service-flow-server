// tsconfig.test.json (root level, same folder as tsconfig.json)
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "rootDir": ".",
    "baseUrl": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
